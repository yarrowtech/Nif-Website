# Example environment variables for backend
# Copy this file to .env and fill values before running

# Port the server should listen on (Render/Heroku set this automatically)
PORT=5000

# Gmail account used to send emails (for nodemailer)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-password-or-app-password

# Alternatively, use SendGrid (recommended for production). If you set SENDGRID_API_KEY
# the server will prefer SendGrid's HTTP API and avoid direct SMTP connections.
SENDGRID_API_KEY=
EMAIL_FROM=you@your-domain.com

# Safe testing mode: set to 'true' to log emails instead of sending them
# Useful while configuring providers in staging or when you don't want to send real emails
DRY_RUN_EMAIL=false
